{
  "rules": [
    {
      "id": "docs-text",
      "patterns": [
        "README.md",
        "AGENTS.md",
        "docs/**"
      ],
      "commands": [
        "typecheck"
      ],
      "lane": "fast",
      "reason": "Documentation-only changes receive a lightweight repository sanity check."
    },
    {
      "id": "mcp-contract-safe",
      "patterns": [
        "src/server/contracts/devflowContract.ts",
        "tests/server/devflowSafeEditRoute.test.ts",
        "tests/server/devflowToolProfile.test.ts"
      ],
      "checks": [
        {
          "command": "test-focused",
          "targets": [
            "tests/server/devflowSafeEditRoute.test.ts",
            "tests/server/devflowToolProfile.test.ts"
          ]
        },
        {
          "command": "typecheck"
        }
      ],
      "lane": "safe",
      "reason": "MCP contract and tool-profile changes use focused transport/profile regressions plus typecheck while preserving SAFE risk semantics."
    },
    {
      "id": "task-claim-focused",
      "patterns": [
        "src/server/services/taskClaimService.ts",
        "tests/server/taskClaimService.test.ts"
      ],
      "commands": [
        "test-focused"
      ],
      "targets": [
        "tests/server/taskClaimService.test.ts"
      ],
      "lane": "fast",
      "reason": "Task-claim behavior is covered by its focused server regression suite."
    },
    {
      "id": "start-all-tunnel",
      "patterns": [
        "scripts/start-all.ts",
        "scripts/openai-tunnel.ts",
        "scripts/verify-start-all.ts",
        "src/lib/devFlowSupervisor.ts"
      ],
      "commands": [
        "test-start-all"
      ],
      "lane": "fast",
      "reason": "Start-all and OpenAI tunnel lifecycle changes are covered by the focused supervisor/tunnel verifier."
    },
    {
      "id": "project-command-tests",
      "patterns": [
        "tests/server/projectCommandService.test.ts",
        "tests/server/projectCommandVerificationCandidate.test.ts"
      ],
      "commands": [
        "test-command-service"
      ],
      "lane": "fast",
      "reason": "Project-command test changes are covered by the repository project-command preset."
    }
  ]
}
