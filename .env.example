# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# One-click startup:
# DEVFLOW_PORT=3000
# DEVFLOW_ZROK_RESERVED_NAME="devflow-mixed"
# DEVFLOW_ZROK_PUBLIC_URL="https://devflow-mixed.shares.zrok.io"
# DEVFLOW_ZROK_PROBE_INTERVAL_MS=15000
# DEVFLOW_ZROK_PROBE_TIMEOUT_MS=5000
# DEVFLOW_ZROK_PROBE_STARTUP_GRACE_MS=30000
# DEVFLOW_ZROK_PROBE_FAILURE_THRESHOLD=3
# DEVFLOW_ZROK_RECOVERY_COOLDOWN_MS=15000
# DEVFLOW_OPEN_BROWSER=true
# DEVFLOW_OPEN_BROWSER_DELAY_MS=4000

# The zrok account token is requested interactively on first Windows bootstrap.
# Do not store the account token in this file.

# Agent credentials fallback configuration (UI settings override these):
# GITHUB_PERSONAL_ACCESS_TOKEN=""
# JIRA_BASE_URL=""
# JIRA_EMAIL=""
# JIRA_API_TOKEN=""
