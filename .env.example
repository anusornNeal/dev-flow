# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# One-click startup:
# DEVFLOW_PORT=3000
# DEVFLOW_OPENAI_TUNNEL_ID="tunnel_your_id"
# CONTROL_PLANE_API_KEY="" # OpenAI Tunnel runtime key; keep this file local and never commit it.
# DEVFLOW_TUNNEL_ALIAS="devflow"
# DEVFLOW_TUNNEL_CLIENT_BIN="tunnel-client" # optional when tunnel-client is already on PATH
# DEVFLOW_TUNNEL_RUNTIME_KEY_ENV="CONTROL_PLANE_API_KEY" # optional indirection when the runtime key uses another env var
# DEVFLOW_TUNNEL_STARTUP_WAIT_MS=30000
# DEVFLOW_OPEN_BROWSER=true
# DEVFLOW_OPEN_BROWSER_DELAY_MS=4000

# Tunnel-client runtime state defaults to ignored .devflow/tunnel-client.
# Set TUNNEL_CLIENT_STATE_DIR only when you intentionally want another machine-local state directory.

# Agent credentials fallback configuration (UI settings override these):
# GITHUB_PERSONAL_ACCESS_TOKEN=""
# JIRA_BASE_URL=""
# JIRA_EMAIL=""
# JIRA_API_TOKEN=""
